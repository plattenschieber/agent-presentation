    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "nanoid@3.3.3": "3.3.20",
